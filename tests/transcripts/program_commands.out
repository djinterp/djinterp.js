> # the program's own commands over the fixture's djins
> list
exit 0
out: printer  -  settings only
out: net      -  settings only
out: cache    -  settings only
out: cli      -  settings only
> describe printer
exit 0
out: printer
out:   settings only
out: 
out: settings
out:   printer.key_width  int     30         D_CFG_ENV_PRINTER_KEY_WIDTH  the width of a key
out:   printer.style      choice  plain      D_CFG_ENV_PRINTER_STYLE      how a description is written
out:   printer.select     flags   3          -                            the sections written
out:   printer.prefix     text    "> "       -                            a text whose default needs quotes
out:   printer.banner     bool    false      -                            a bool the environment may not set
out:   printer.seed       int     0          -                            an int of any value
out:   printer.scale      real    1          -
out:   printer.module     text    "builtin"  D_CFG_ENV_PRINTER_MODULE     a text only the program and the command line set
out:   printer.width      int     80         -                            a name the root declares too
> describe net
exit 0
out: net
out:   settings only
out: 
out: settings
out:   net.host  text    "localhost"  -  a text with a default
out:   net.port  int     8080         -  an int with an alias
out:   net.mode  choice  off          -  a choice of 64-bit values
out:   net.bits  flags   0            -  flags with the sign bit
out:   net.big   int     0            -  an int one past the exact integers each way
> describe cache
exit 0
out: cache
out:   settings only
out: 
out: settings
out:   cache.size  int   64     -
out:   cache.path  text  unset  -  where it is kept
> describe cli
exit 0
out: cli
out:   settings only
out: 
out: settings
out:   cli.plugin_search          text  "$ORIGIN:$ORIGIN/../lib/$PROGRAM"  D_CFG_CLI_PLUGIN_SEARCH          the directories a command's module is looked for in, after the run's and plugin_path's
out:   cli.plugin_strict_version  bool  true                               D_CFG_CLI_PLUGIN_STRICT_VERSION  whether a module of another version of the program is refused, or loaded with a warning
