out:         1) p=0 f=f m=1 ;;
out:         2) p=0 f=f m=1 ;;
out:         3) p=0 f=f m=1 ;;
out:         4) p=0 f=f m=1 ;;
out:         5) p=0 f=f m=1 ;;
out:         6) p=0 f=f m=1 ;;
