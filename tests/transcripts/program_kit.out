out: _djarg_djinterp_sub() {
out:     case $1:$2 in
out:         '0:list') r=1 ;;
out:         '0:describe') r=2 ;;
out:         '0:get') r=3 ;;
out:         '0:set') r=4 ;;
out:         '0:help') r=5 ;;
