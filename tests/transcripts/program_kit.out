out:     )
out:     $info = @(
out:         '0 0 - 0 0'
out:         '0 0 - 0 0'
out:         '0 0 - 0 0'
out:         '0 0 - 0 0'
out:         '0 0 - 0 0'
out:         '0 0 - 0 0'
out:         '0 0 - 0 0'
out:         '1 1 f 0 0'
out:         '0 0 - 0 0'
out:         '0 0 f 0 0'
out:         '0 0 - 0 0'
out:         '0 0 - 0 0'
out:         '1 1 f 0 0'
out:         '0 0 - 0 0'
out:         '0 2 f 0 0'
out:         '0 0 - 0 0'
out:         '1 1 f 0 0'
out:     )
out:     $ps = @(
out:         '2:0'
out:         '3:0'
out:         '4:0'
out:         '5:0'
out:         '6:0'
out:     )
out:     $pv = @(
out:         '7 1'
out:         '9 -1'
out:         '12 -1'
out:         '14 2'
out:         '16 1'
out:     )
out:     $vv = @(
out:     )
out:     $ordinal = [System.StringComparer]::Ordinal
out:     $sk = [Collections.Generic.Dictionary[string,int]]::new(
out:         $ordinal)
out:     for ($i = 0; $i -lt $sn.Count; $i++) {
out:         $sk[[string]$sc[$i] + ':' + $sn[$i]] = $st[$i]
out:     }
out:     $ok = [Collections.Generic.Dictionary[string,int]]::new(
out:         $ordinal)
out:     for ($i = 0; $i -lt $on.Count; $i++) {
out:         $ok[[string]$oc[$i] + ':' + $on[$i]] = $ov[$i]
out:     }
out:     $pk = [Collections.Generic.Dictionary[string,string]]::new(
out:         $ordinal)
out:     for ($i = 0; $i -lt $ps.Count; $i++) {
out:         $pk[$ps[$i]] = $pv[$i]
out:     }
out:     $complete = {
out:         param($wordToComplete, $commandAst, $cursorPosition)
out:         $s = @{ cmd = 0; cf = ''; opt = -1; need = 0; room = 0
out:                 only = $false; extra = ''; used = @{}; counts = @{} }
out:         $ord = [System.StringComparison]::Ordinal
out:         $any = [System.StringComparison]::OrdinalIgnoreCase
out:         $completers = [Management.Automation.CompletionCompleters]
out:         $result = [Management.Automation.CompletionResult]
out:         $constant = ('System.Management.Automation.Language.' +
out:                      'StringConstantExpressionAst') -as [type]
out:         function Cmd([int]$L) {
out:             # the command's row
out:             $e = $cmds[$L].Split(' ')
out:             @{ p = [int]$e[0]; f = $e[1]; m = [int]$e[2]
out:                sa = [int]$e[3]; sc = [int]$e[4]
out:                oa = [int]$e[5]; oc = [int]$e[6] }
out:         }
out:         function Info([int]$o) {
out:             # the option's row
out:             $e = $info[$o].Split(' ')
out:             @{ n = [int]$e[0]; x = [int]$e[1]; k = $e[2]
out:                va = [int]$e[3]; vc = [int]$e[4] }
out:         }
out:         function First([string]$c) {
out:             # whether the character may begin a name
out:             ($c.Length -gt 0) -and
out:                 ($c -cnotmatch '^[-!\s\x00-\x1f\x7f]')
out:         }
out:         function Used([int]$L) {
out:             # the subcommands the command was given
out:             if ($s.used.ContainsKey($L)) {
out:                 return $s.used[$L]
out:             }
out:             return 0
out:         }
out:         function Find([string]$name) {
out:             # the option named at the command or, falling
out:             # through, above it; -1 for none
out:             $L = $s.cmd
out:             while ($true) {
out:                 $v = 0
out:                 if ($ok.TryGetValue([string]$L + ':' + $name,
out:                                     [ref]$v)) {
out:                     return $v
out:                 }
out:                 $c = Cmd $L
out:                 if ($c.f.Contains('f') -and ($L -ne 0)) {
out:                     $L = $c.p
out:                 }
out:                 else {
out:                     return -1
out:                 }
out:             }
out:         }
out:         function Target([string]$w) {
out:             # the subcommand the word names, from the command up,
out:             # and the command it is under; $null for none
out:             $L = $s.cmd
out:             while ($true) {
out:                 $c = Cmd $L
out:                 if (($c.m -eq 0) -or ((Used $L) -lt $c.m) -or
out:                     (-not $c.f.Contains('s'))) {
out:                     $t = 0
out:                     if ($sk.TryGetValue([string]$L + ':' + $w,
out:                                         [ref]$t)) {
out:                         return @($t, $L)
out:                     }
out:                 }
out:                 if ($c.f.Contains('s') -and ($L -ne 0)) {
out:                     $L = $c.p
out:                 }
out:                 else {
out:                     return $null
out:                 }
out:             }
out:         }
out:         function Class([string]$w) {
out:             # what the word is to the command
out:             if ($w -ceq '--') {
out:                 return 'mark'
out:             }
out:             if ($null -ne (Target $w)) {
out:                 return 'sub'
out:             }
out:             if ($w.StartsWith('--', $ord)) {
out:                 if (($w.Length -gt 2) -and (First $w.Substring(2, 1))) {
out:                     return 'long'
out:                 }
out:                 return 'none'
out:             }
out:             if ($w.StartsWith('-', $ord) -and ($w.Length -gt 1)) {
out:                 $first = $w.Substring(1, 1)
out:                 if (-not (First $first)) {
out:                     return 'none'
out:                 }
out:                 if (($w -cmatch '^-([0-9]|\.[0-9])') -and
out:                     (-not $ok.ContainsKey([string]$s.cmd + ':-' +
out:                                           $first))) {
out:                     return 'none'
out:                 }
out:                 return 'short'
out:             }
out:             if ($s.cf.Contains('w') -and $w.StartsWith('/', $ord) -and
out:                 ($w.Length -gt 1) -and (First $w.Substring(1, 1))) {
out:                 return 'win'
out:             }
out:             if (($w -ceq '++') -and ($s.cmd -ne 0)) {
out:                 return 'term'
out:             }
out:             return 'none'
out:         }
out:         function Take([bool]$count) {
out:             # the positional that takes a word, from the command
out:             # up, counted when asked; -1 for none
out:             $L = $s.cmd
out:             while ($true) {
out:                 $slot = 0
out:                 while ($true) {
out:                     $e = $null
out:                     if (-not $pk.TryGetValue([string]$L + ':' + $slot,
out:                                              [ref]$e)) {
out:                         break
out:                     }
out:                     $e = $e.Split(' ')
out:                     $o = [int]$e[0]
out:                     $c = 0
out:                     if ($s.counts.ContainsKey($o)) {
out:                         $c = $s.counts[$o]
out:                     }
out:                     if (([int]$e[1] -lt 0) -or ($c -lt [int]$e[1])) {
out:                         if ($count) {
out:                             $s.counts[$o] = $c + 1
out:                         }
out:                         return $o
out:                     }
out:                     $slot++
out:                 }
out:                 $c = Cmd $L
out:                 if ($c.f.Contains('f') -and ($L -ne 0)) {
out:                     $L = $c.p
out:                 }
out:                 else {
out:                     $s.extra = $c.f
out:                     return -1
out:                 }
out:             }
out:         }
out:         function Given([int]$o, [string]$value) {
out:             # the option met with a value -- empty for none: what
out:             # it still needs, and what more it may take
out:             if ($o -lt 0) {
out:                 return
out:             }
out:             $i = Info $o
out:             if ($i.x -eq 0) {
out:                 return
out:             }
out:             $got = 0
out:             if ($value.Length -gt 0) {
out:                 $got = 1
out:             }
out:             $s.need = [Math]::Max(0, $i.n - $got)
out:             if ($i.x -lt 0) {
out:                 $s.room = -1
out:             }
out:             elseif ($got -gt $i.n) {
out:                 $s.room = $i.x - $got
out:             }
out:             else {
out:                 $s.room = $i.x - $i.n
out:             }
out:             if (($s.need -gt 0) -or ($s.room -ne 0)) {
out:                 $s.opt = $o
out:             }
out:         }
out:         function Named([string]$w, [string]$at) {
out:             # a long or Windows-style name met, with its value
out:             $i = $w.IndexOf($at)
out:             $name = $w
out:             $value = ''
out:             if ($i -ge 0) {
out:                 $name = $w.Substring(0, $i)
out:                 $value = $w.Substring($i + 1)
out:             }
out:             if ($at -ceq '=') {
out:                 $o = Find $name
out:             }
out:             else {
out:                 $o = Find ('--' + $name.Substring(1))
out:                 if ($o -lt 0) {
out:                     $o = Find ('-' + $name.Substring(1))
out:                 }
out:             }
out:             Given $o $value
out:         }
out:         function Step([string]$w) {
out:             # one word the parse meets
out:             switch (Class $w) {
out:                 'mark' {
out:                     $s.only = $true
out:                 }
out:                 'sub' {
out:                     $t = Target $w
out:                     $s.used[$t[1]] = (Used $t[1]) + 1
out:                     $s.cmd = $t[0]
out:                     $s.cf = (Cmd $s.cmd).f
out:                 }
out:                 'term' {
out:                     $s.cmd = (Cmd $s.cmd).p
out:                     $s.cf = (Cmd $s.cmd).f
out:                 }
out:                 'long' {
out:                     Named $w '='
out:                 }
out:                 'win' {
out:                     Named $w ':'
out:                 }
out:                 'short' {
out:                     $rest = $w.Substring(1)
out:                     while ($rest.Length -gt 0) {
out:                         $o = Find ('-' + $rest.Substring(0, 1))
out:                         $rest = $rest.Substring(1)
out:                         if ($o -lt 0) {
out:                             break
out:                         }
out:                         if ((Info $o).x -ne 0) {
out:                             Given $o $rest
out:                             break
out:                         }
out:                     }
out:                 }
out:                 default {
out:                     $null = Take $true
out:                 }
out:             }
out:         }
out:         function Result([string]$text, [string]$pre, [string]$type,
out:                         [string]$tip) {
out:             # a completion of the text, quoted where it must be
out:             $q = $text
out:             if (($q.Length -eq 0) -or
out:                 ($q -match '[\s''"`$(){}<>;,&|@#\u2018-\u201b]')) {
out:                 $quotes = '[''\u2018-\u201b]'
out:                 $q = "'" + ($q -replace $quotes, '$0$0') + "'"
out:             }
out:             if ([string]::IsNullOrEmpty($tip)) {
out:                 $tip = $text
out:             }
out:             $list = $text
out:             if ($list.Length -eq 0) {
out:                 $list = "''"
out:             }
out:             $result::new($pre + $q, $list, $type, $tip)
out:         }
out:         function Kind([string]$k, [int]$va, [int]$vc, [string]$pre,
out:                       [string]$word) {
out:             # the values of a kind -- c, choices; f, files; d,
out:             # directories -- that start with the word, after $pre
out:             if ($k -ceq 'c') {
out:                 for ($i = $va; $i -lt $va + $vc; $i++) {
out:                     if ($vv[$i].StartsWith($word, $any)) {
out:                         Result $vv[$i] $pre 'ParameterValue' ''
out:                     }
out:                 }
out:             }
out:             elseif (($k -ceq 'f') -or ($k -ceq 'd')) {
out:                 $all = $completers::CompleteFilename($word)
out:                 foreach ($r in $all) {
out:                     if (($k -ceq 'f') -or
out:                         ($r.ResultType -eq 'ProviderContainer')) {
out:                         $result::new($pre + $r.CompletionText,
out:                                      $r.ListItemText, $r.ResultType,
out:                                      $r.ToolTip)
out:                     }
out:                 }
out:             }
out:         }
out:         function Values([int]$o, [string]$pre, [string]$word) {
out:             # the values the option takes
out:             $i = Info $o
out:             Kind $i.k $i.va $i.vc $pre $word
out:         }
out:         function Names([string]$which, [string]$word) {
out:             # the names -- s, subcommands; o, options -- that start
out:             # with the word, each once with its description: at the
out:             # command and, for options falling through, above it
out:             $L = $s.cmd
out:             $seen = @{}
out:             while ($true) {
out:                 $c = Cmd $L
out:                 $a = $c.sa
out:                 $z = $c.sa + $c.sc
out:                 $names = $sn
out:                 $texts = $sd
out:                 $type = 'Command'
out:                 if ($which -ceq 'o') {
out:                     $a = $c.oa
out:                     $z = $c.oa + $c.oc
out:                     $names = $on
out:                     $texts = $od
out:                     $type = 'ParameterName'
out:                 }
out:                 for ($i = $a; $i -lt $z; $i++) {
out:                     $name = $names[$i]
out:                     if ((-not $seen.ContainsKey($name)) -and
out:                         $name.StartsWith($word, $any)) {
out:                         $seen[$name] = 1
out:                         Result $name '' $type $texts[$i]
out:                     }
out:                 }
out:                 if (($which -ceq 'o') -and $c.f.Contains('f') -and
out:                     ($L -ne 0)) {
out:                     $L = $c.p
out:                 }
out:                 else {
out:                     return
out:                 }
out:             }
out:         }
out:         function Offer([string]$cur) {
out:             # what may come at the cursor
out:             if ($s.need -gt 0) {
out:                 Values $s.opt '' $cur
out:                 return
out:             }
out:             if ($s.only) {
out:                 $o = Take $false
out:                 if ($o -ge 0) {
out:                     Values $o '' $cur
out:                 }
out:                 return
out:             }
out:             if ($s.opt -ge 0) {
out:                 Values $s.opt '' $cur
out:             }
out:             if ($cur -cmatch '^--[^=]*=') {
out:                 $i = $cur.IndexOf('=')
out:                 $o = Find $cur.Substring(0, $i)
out:                 if ($o -ge 0) {
out:                     $pre = $cur.Substring(0, $i + 1)
out:                     Values $o $pre $cur.Substring($i + 1)
out:                 }
out:             }
out:             elseif ($cur.StartsWith('-', $ord)) {
out:                 Names 'o' $cur
out:             }
out:             else {
out:                 $o = Take $false
out:                 if ($o -ge 0) {
out:                     Values $o '' $cur
out:                 }
out:                 elseif ($s.extra.Contains('e')) {
out:                     Kind 'f' 0 0 '' $cur
out:                 }
out:                 $c = Cmd $s.cmd
out:                 if (($c.sc -gt 0) -and
out:                     (($c.m -eq 0) -or ((Used $s.cmd) -lt $c.m))) {
out:                     Names 's' $cur
out:                 }
out:                 elseif (($o -lt 0) -and (-not $s.extra.Contains('e'))) {
out:                     Names 'o' $cur
out:                 }
out:             }
out:         }
out:         function Main {
out:             # the words to the cursor walked, then what may come
out:             $words = @()
out:             $elements = $commandAst.CommandElements
out:             for ($i = 1; $i -lt $elements.Count; $i++) {
out:                 $e = $elements[$i]
out:                 if ($e.Extent.EndOffset -ge $cursorPosition) {
out:                     break
out:                 }
out:                 if ($e -is $constant) {
out:                     $words += , $e.Value
out:                 }
out:                 else {
out:                     $words += , $e.Extent.Text
out:                 }
out:             }
out:             $s.cf = (Cmd 0).f
out:             foreach ($w in $words) {
out:                 if ($s.need -gt 0) {
out:                     $s.need--
out:                     if (($s.need -eq 0) -and ($s.room -eq 0)) {
out:                         $s.opt = -1
out:                     }
out:                     continue
out:                 }
out:                 if ($s.only) {
out:                     $null = Take $true
out:                     continue
out:                 }
out:                 if ($s.opt -ge 0) {
out:                     if ($w -ceq '--') {
out:                         $s.opt = -1
out:                         continue
out:                     }
out:                     if (((Class $w) -ceq 'none') -and ($s.room -ne 0)) {
out:                         if ($s.room -gt 0) {
out:                             $s.room--
out:                         }
out:                         if ($s.room -eq 0) {
out:                             $s.opt = -1
out:                         }
out:                         continue
out:                     }
out:                     $s.opt = -1
out:                 }
out:                 Step $w
out:             }
out:             $cur = $wordToComplete
out:             if ($cur -cmatch "^'(.*)'$") {
out:                 $cur = $Matches[1] -replace "''", "'"
out:             }
out:             elseif ($cur -cmatch '^"(.*)"$') {
out:                 $cur = $Matches[1]
out:             }
out:             elseif ($cur -cmatch '^[''"]') {
out:                 $cur = $cur.Substring(1)
out:             }
out:             Offer $cur
out:         }
out:         $results = @(Main)
out:         if (($results.Count -eq 0) -and
out:             ($wordToComplete.Length -gt 0)) {
out:             # the word as it stands, so that PowerShell does not offer
out:             # files where nothing fits
out:             $w = $wordToComplete
out:             $result::new($w, $w, 'ParameterValue', $w)
out:         }
out:         else {
out:             $results
out:         }
out:     }.GetNewClosure()
out:     Register-ArgumentCompleter -Native -CommandName @( 'djinterp', 'djinterp.exe') -ScriptBlock $complete
out: }
