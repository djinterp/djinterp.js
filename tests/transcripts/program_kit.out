out: # bash completion for djinterp, generated by djinterp's arg_parser.
out: # Source it in bash, or save it among bash-completion's completions.
out: 
out: _djarg_djinterp_cmd() {
out:     case $1 in
out:         0) p=0 f=s m=1 ;;
out:         1) p=0 f=f m=1 ;;
out:         2) p=0 f=f m=1 ;;
out:         3) p=0 f=f m=1 ;;
out:         4) p=0 f=f m=1 ;;
out:         5) p=0 f=f m=1 ;;
out:         6) p=0 f=f m=1 ;;
out:         *) p=0 f=- m=0 ;;
out:     esac
out: }
out: _djarg_djinterp_sub() {
out:     case $1:$2 in
out:         '0:list') r=1 ;;
out:         '0:describe') r=2 ;;
out:         '0:get') r=3 ;;
out:         '0:set') r=4 ;;
out:         '0:help') r=5 ;;
out:         '0:completion') r=6 ;;
out:         *) r= ;;
out:     esac
out: }
out: _djarg_djinterp_opt() {
out:     case $1:$2 in
out:         '0:-h') r=0 ;;
out:         '0:--help') r=0 ;;
out:         '0:--version') r=1 ;;
out:         '0:-q') r=2 ;;
out:         '0:--quiet') r=2 ;;
out:         '0:-v') r=3 ;;
out:         '0:--verbose') r=3 ;;
out:         '0:--color') r=4 ;;
out:         '1:-h') r=5 ;;
out:         '1:--help') r=5 ;;
out:         '2:-h') r=6 ;;
out:         '2:--help') r=6 ;;
out:         '3:-h') r=8 ;;
out:         '3:--help') r=8 ;;
out:         '3:--show-origin') r=10 ;;
out:         '4:-h') r=11 ;;
out:         '4:--help') r=11 ;;
out:         '5:-h') r=13 ;;
out:         '5:--help') r=13 ;;
out:         '6:-h') r=15 ;;
out:         '6:--help') r=15 ;;
out:         *) r= ;;
out:     esac
out: }
out: _djarg_djinterp_info() {
out:     case $1 in
out:         0) n=0 x=0 k=- ;;
out:         1) n=0 x=0 k=- ;;
out:         2) n=0 x=0 k=- ;;
out:         3) n=0 x=0 k=- ;;
out:         4) n=0 x=0 k=- ;;
out:         5) n=0 x=0 k=- ;;
out:         6) n=0 x=0 k=- ;;
out:         7) n=1 x=1 k=f ;;
out:         8) n=0 x=0 k=- ;;
out:         9) n=0 x=0 k=f ;;
out:         10) n=0 x=0 k=- ;;
out:         11) n=0 x=0 k=- ;;
out:         12) n=1 x=1 k=f ;;
out:         13) n=0 x=0 k=- ;;
out:         14) n=0 x=2 k=f ;;
out:         15) n=0 x=0 k=- ;;
out:         16) n=1 x=1 k=f ;;
out:         *) n=0 x=0 k=- ;;
out:     esac
out: }
out: _djarg_djinterp_pos() {
out:     case $1:$2 in
out:         2:0) r=7 y=1 ;;
out:         3:0) r=9 y=-1 ;;
out:         4:0) r=12 y=-1 ;;
out:         5:0) r=14 y=2 ;;
out:         6:0) r=16 y=1 ;;
out:         *) r= ;;
out:     esac
out: }
out: _djarg_djinterp_subs() {
out:     case $1 in
out:         0) c=( 'list' 'describe' 'get' 'set' 'help' 'completion' ) ;;
out:         *) c=() ;;
out:     esac
out: }
out: _djarg_djinterp_opts() {
out:     case $1 in
out:         0) c=( '-h' '--help' '--version' '-q' '--quiet' '-v' '--verbose' '--color' ) ;;
out:         1) c=( '-h' '--help' ) ;;
out:         2) c=( '-h' '--help' ) ;;
out:         3) c=( '-h' '--help' '--show-origin' ) ;;
out:         4) c=( '-h' '--help' ) ;;
out:         5) c=( '-h' '--help' ) ;;
out:         6) c=( '-h' '--help' ) ;;
out:         *) c=() ;;
out:     esac
out: }
out: _djarg_djinterp_vals() {
out:     case $1 in
out:         *) c=() ;;
out:     esac
out: }
out: __djarg_djinterp_first() {
out:     # whether `$1` may begin a name
out:     case $1 in
out:         ''|-|'!'|[[:space:]]|[[:cntrl:]]) return 1 ;;
out:     esac
out:     return 0
out: }
out: __djarg_djinterp_find() {
out:     # o: the option named `$1` at the command or, falling
out:     # through, above it
out:     local L=$cmd p f m r
out:     o=
out:     while :; do
out:         _djarg_djinterp_opt "$L" "$1"
out:         if [[ -n $r ]]; then
out:             o=$r
out:             return
out:         fi
out:         _djarg_djinterp_cmd "$L"
out:         if [[ $f == *f* ]] && (( L != 0 )); then
out:             L=$p
out:         else
out:             return
out:         fi
out:     done
out: }
out: __djarg_djinterp_target() {
out:     # t: the subcommand `$1` names, from the command up, and l:
out:     # the command it is under
out:     local L=$cmd p f m r
out:     t= l=
out:     while :; do
out:         _djarg_djinterp_cmd "$L"
out:         if (( m == 0 )) || (( ${used[$L]:-0} < m )) ||
out:            [[ $f != *s* ]]; then
out:             _djarg_djinterp_sub "$L" "$1"
out:             if [[ -n $r ]]; then
out:                 t=$r l=$L
out:                 return
out:             fi
out:         fi
out:         if [[ $f == *s* ]] && (( L != 0 )); then
out:             L=$p
out:         else
out:             return
out:         fi
out:     done
out: }
out: __djarg_djinterp_class() {
out:     # r: what `$1` is to the command -- mark, sub, long, short,
out:     # win, term or none
out:     local w=$1
out:     r=none
out:     if [[ $w == -- ]]; then
out:         r=mark
out:         return
out:     fi
out:     __djarg_djinterp_target "$w"
out:     if [[ -n $t ]]; then
out:         r=sub
out:         return
out:     fi
out:     case $w in
out:         --?*)
out:             if __djarg_djinterp_first "${w:2:1}"; then
out:                 r=long
out:             fi
out:             return
out:             ;;
out:         -?*)
out:             if ! __djarg_djinterp_first "${w:1:1}"; then
out:                 return
out:             fi
out:             case ${w:1:2} in
out:                 [0-9]*|.[0-9])
out:                     _djarg_djinterp_opt "$cmd" "-${w:1:1}"
out:                     if [[ -z $r ]]; then
out:                         r=none
out:                         return
out:                     fi
out:                     ;;
out:             esac
out:             r=short
out:             return
out:             ;;
out:     esac
out:     if [[ $cf == *w* ]] && [[ $w == /?* ]] &&
out:        __djarg_djinterp_first "${w:1:1}"; then
out:         r=win
out:     elif [[ $w == ++ ]] && (( cmd != 0 )); then
out:         r=term
out:     fi
out: }
out: __djarg_djinterp_take() {
out:     # o: the positional that takes a word, from the command up,
out:     # counted when `$1` is 1; extra: the last command's flags
out:     local L=$cmd s r y p f m
out:     o=
out:     while :; do
out:         s=0
out:         while :; do
out:             _djarg_djinterp_pos "$L" "$s"
out:             if [[ -z $r ]]; then
out:                 break
out:             fi
out:             if (( y < 0 )) || (( ${counts[$r]:-0} < y )); then
out:                 o=$r
out:                 if (( $1 )); then
out:                     counts[$r]=$(( ${counts[$r]:-0} + 1 ))
out:                 fi
out:                 return
out:             fi
out:             s=$(( s + 1 ))
out:         done
out:         _djarg_djinterp_cmd "$L"
out:         if [[ $f == *f* ]] && (( L != 0 )); then
out:             L=$p
out:         else
out:             extra=$f
out:             return
out:         fi
out:     done
out: }
out: __djarg_djinterp_given() {
out:     # the option found, met with the value `$1` -- empty for
out:     # none: what it still needs, and what more it may take
out:     local n x k got=0
out:     if [[ -z $o ]]; then
out:         return
out:     fi
out:     _djarg_djinterp_info "$o"
out:     if (( x == 0 )); then
out:         return
out:     fi
out:     if [[ -n $1 ]]; then
out:         got=1
out:     fi
out:     need=$(( n - got ))
out:     if (( need < 0 )); then
out:         need=0
out:     fi
out:     if (( x < 0 )); then
out:         room=-1
out:     elif (( got > n )); then
out:         room=$(( x - got ))
out:     else
out:         room=$(( x - n ))
out:     fi
out:     if (( need > 0 )) || (( room != 0 )); then
out:         opt=$o
out:     fi
out: }
out: __djarg_djinterp_step() {
out:     # one word the parse meets
out:     local w=$1 r t l o name rest n x k
out:     __djarg_djinterp_class "$w"
out:     case $r in
out:         mark)
out:             only=1
out:             ;;
out:         sub)
out:             used[$l]=$(( ${used[$l]:-0} + 1 ))
out:             cmd=$t
out:             _djarg_djinterp_cmd "$cmd"
out:             cf=$f
out:             ;;
out:         term)
out:             _djarg_djinterp_cmd "$cmd"
out:             cmd=$p
out:             _djarg_djinterp_cmd "$cmd"
out:             cf=$f
out:             ;;
out:         long)
out:             name=${w%%=*}
out:             rest=${w#"$name"}
out:             __djarg_djinterp_find "$name"
out:             __djarg_djinterp_given "${rest:1}"
out:             ;;
out:         win)
out:             name=${w%%:*}
out:             rest=${w#"$name"}
out:             __djarg_djinterp_find "--${name:1}"
out:             if [[ -z $o ]]; then
out:                 __djarg_djinterp_find "-${name:1}"
out:             fi
out:             __djarg_djinterp_given "${rest:1}"
out:             ;;
out:         short)
out:             rest=${w:1}
out:             while [[ -n $rest ]]; do
out:                 name=-${rest:0:1}
out:                 rest=${rest:1}
out:                 __djarg_djinterp_find "$name"
out:                 if [[ -z $o ]]; then
out:                     break
out:                 fi
out:                 _djarg_djinterp_info "$o"
out:                 if (( x != 0 )); then
out:                     __djarg_djinterp_given "$rest"
out:                     break
out:                 fi
out:             done
out:             ;;
out:         *)
out:             __djarg_djinterp_take 1
out:             ;;
out:     esac
out: }
out: __djarg_djinterp_words() {
out:     # words and cword: the line to the cursor in words, rejoining
out:     # what COMP_WORDBREAKS split; tail: the part readline replaces
out:     local line=${COMP_LINE:0:COMP_POINT} i=0 w lead
out:     words=() cword=-1 tail=
out:     while (( i <= COMP_CWORD )); do
out:         w=${COMP_WORDS[i]}
out:         lead=${line%%[![:space:]]*}
out:         line=${line#"$lead"}
out:         if (( i == COMP_CWORD )); then
out:             w=$line
out:         fi
out:         line=${line#"$w"}
out:         if [[ -n $lead ]] || (( cword < 0 )); then
out:             cword=$(( cword + 1 ))
out:             words[cword]=$w
out:         else
out:             words[cword]=${words[cword]}$w
out:         fi
out:         i=$(( i + 1 ))
out:     done
out:     tail=$w
out: }
out: __djarg_djinterp_unq() {
out:     # r: `$1` with its quotes and escapes removed
out:     local s=$1 out= ch q=
out:     case $s in
out:         *[\\\'\"]*) ;;
out:         *) r=$s; return ;;
out:     esac
out:     while [[ -n $s ]]; do
out:         ch=${s:0:1} s=${s:1}
out:         if [[ $q == "'" ]]; then
out:             if [[ $ch == "'" ]]; then
out:                 q=
out:             else
out:                 out=$out$ch
out:             fi
out:         elif [[ $q == '"' ]]; then
out:             if [[ $ch == '"' ]]; then
out:                 q=
out:             elif [[ $ch == '\' ]]; then
out:                 case ${s:0:1} in
out:                     '"'|'\'|'$'|'`') out=$out${s:0:1} s=${s:1} ;;
out:                     *) out=$out$ch ;;
out:                 esac
out:             else
out:                 out=$out$ch
out:             fi
out:         else
out:             case $ch in
out:                 "'"|'"') q=$ch ;;
out:                 '\') out=$out${s:0:1} s=${s:1} ;;
out:                 *) out=$out$ch ;;
out:             esac
out:         fi
out:     done
out:     r=$out
out: }
out: __djarg_djinterp_kind() {
out:     # the values of kind `$1` -- c, the choices in c; f, files; d,
out:     # directories -- that start with `$3`, after `$2`
out:     local v
out:     case $1 in
out:         c)
out:             if (( ${#c[@]} > 0 )); then
out:                 for v in "${c[@]}"; do
out:                     if [[ $v == "$3"* ]]; then
out:                         reply+=( "$2$v" )
out:                     fi
out:                 done
out:             fi
out:             ;;
out:         f|d)
out:             files=1
out:             while IFS= read -r v; do
out:                 reply+=( "$2$v" )
out:             done < <(compgen -"$1" -- "$3")
out:             ;;
out:     esac
out: }
out: __djarg_djinterp_values() {
out:     # the values option `$1` takes that start with `$3`, after `$2`
out:     local n x k c=()
out:     _djarg_djinterp_info "$1"
out:     if [[ $k == c ]]; then
out:         _djarg_djinterp_vals "$1"
out:     fi
out:     __djarg_djinterp_kind "$k" "$2" "$3"
out: }
out: __djarg_djinterp_names() {
out:     # the names list `$1` gives that start with `$2`, each once:
out:     # at the command and, for options falling through, above it
out:     local L=$cmd c v p f m seen==
out:     while :; do
out:         c=()
out:         "$1" "$L"
out:         if (( ${#c[@]} > 0 )); then
out:             for v in "${c[@]}"; do
out:                 if [[ $v == "$2"* ]] && [[ $seen != *"=$v="* ]]; then
out:                     seen=$seen$v=
out:                     reply+=( "$v" )
out:                 fi
out:             done
out:         fi
out:         _djarg_djinterp_cmd "$L"
out:         if [[ $1 == *_opts ]] && [[ $f == *f* ]] && (( L != 0 ))
out:         then
out:             L=$p
out:         else
out:             return
out:         fi
out:     done
out: }
out: __djarg_djinterp_reply() {
out:     # COMPREPLY: the reply as readline replaces the word -- less
out:     # what precedes the last word break, and escaped unless quoted
out:     # or completed as file names
out:     local s=$tail ch pre v q
out:     while [[ -n $s ]]; do
out:         ch=${s:0:1} s=${s:1}
out:         case $COMP_WORDBREAKS in
out:             *"$ch"*) ;;
out:             *) break ;;
out:         esac
out:         if [[ -z $s ]]; then
out:             tail=
out:         fi
out:     done
out:     __djarg_djinterp_unq "${words[cword]%"$tail"}"
out:     pre=$r
out:     COMPREPLY=()
out:     if (( ${#reply[@]} > 0 )); then
out:         for v in "${reply[@]}"; do
out:             if [[ $v != "$pre"* ]]; then
out:                 continue
out:             fi
out:             v=${v#"$pre"}
out:             case $tail in
out:                 \'*|\"*) ;;
out:                 *)
out:                     if (( ! files )); then
out:                         printf -v q '%q' "$v"
out:                         v=$q
out:                     fi
out:                     ;;
out:             esac
out:             COMPREPLY+=( "$v" )
out:         done
out:     fi
out:     if (( files )) && type compopt >/dev/null 2>&1; then
out:         compopt -o filenames
out:     fi
out: }
out: __djarg_djinterp_offer() {
out:     # reply: what may come at the cursor, `$cur`
out:     if (( need > 0 )); then
out:         __djarg_djinterp_values "$opt" "" "$cur"
out:         return
out:     fi
out:     if (( only )); then
out:         __djarg_djinterp_take 0
out:         if [[ -n $o ]]; then
out:             __djarg_djinterp_values "$o" "" "$cur"
out:         fi
out:         return
out:     fi
out:     if [[ -n $opt ]]; then
out:         __djarg_djinterp_values "$opt" "" "$cur"
out:     fi
out:     case $cur in
out:         --*=*)
out:             __djarg_djinterp_find "${cur%%=*}"
out:             if [[ -n $o ]]; then
out:                 __djarg_djinterp_values "$o" "${cur%%=*}=" "${cur#*=}"
out:             fi
out:             ;;
out:         -*)
out:             __djarg_djinterp_names _djarg_djinterp_opts "$cur"
out:             ;;
out:         *)
out:             __djarg_djinterp_take 0
out:             if [[ -n $o ]]; then
out:                 __djarg_djinterp_values "$o" "" "$cur"
out:             elif [[ $extra == *e* ]]; then
out:                 __djarg_djinterp_kind f "" "$cur"
out:             fi
out:             _djarg_djinterp_cmd "$cmd"
out:             c=()
out:             if (( m == 0 )) || (( ${used[$cmd]:-0} < m )); then
out:                 _djarg_djinterp_subs "$cmd"
out:             fi
out:             if (( ${#c[@]} > 0 )); then
out:                 __djarg_djinterp_names _djarg_djinterp_subs "$cur"
out:             elif [[ -z $o ]] && [[ $extra != *e* ]]; then
out:                 __djarg_djinterp_names _djarg_djinterp_opts "$cur"
out:             fi
out:             ;;
out:     esac
out: }
out: _djarg_djinterp() {
out:     local words cword tail cur r t l o p f m n x k cf w i
out:     local cmd=0 opt= need=0 room=0 only=0 extra= files=0 nocase=0
out:     local -a used counts reply c
out:     if shopt -q nocasematch; then
out:         nocase=1
out:         shopt -u nocasematch
out:     fi
out:     __djarg_djinterp_words
out:     _djarg_djinterp_cmd 0
out:     cf=$f
out:     i=1
out:     while (( i < cword )); do
out:         __djarg_djinterp_unq "${words[i]}"
out:         w=$r
out:         i=$(( i + 1 ))
out:         if (( need > 0 )); then
out:             need=$(( need - 1 ))
out:             if (( need == 0 )) && (( room == 0 )); then
out:                 opt=
out:             fi
out:             continue
out:         fi
out:         if (( only )); then
out:             __djarg_djinterp_take 1
out:             continue
out:         fi
out:         if [[ -n $opt ]]; then
out:             if [[ $w == -- ]]; then
out:                 opt=
out:                 continue
out:             fi
out:             __djarg_djinterp_class "$w"
out:             if [[ $r == none ]] && (( room != 0 )); then
out:                 if (( room > 0 )); then
out:                     room=$(( room - 1 ))
out:                 fi
out:                 if (( room == 0 )); then
out:                     opt=
out:                 fi
out:                 continue
out:             fi
out:             opt=
out:         fi
out:         __djarg_djinterp_step "$w"
out:     done
out:     __djarg_djinterp_unq "${words[cword]}"
out:     cur=$r
out:     reply=()
out:     __djarg_djinterp_offer
out:     __djarg_djinterp_reply
out:     if (( nocase )); then
out:         shopt -s nocasematch
out:     fi
out: }
out: complete -F _djarg_djinterp 'djinterp'
