out: # bash completion for djinterp, generated by djinterp's arg_parser.
out: # Source it in bash, or save it among bash-completion's completions.
out: 
out: _djarg_djinterp_cmd() {
out:     case $1 in
out:         0) p=0 f=s m=1 ;;
out:         1) p=0 f=f m=1 ;;
out:         2) p=0 f=f m=1 ;;
out:         3) p=0 f=f m=1 ;;
out:         4) p=0 f=f m=1 ;;
out:         5) p=0 f=f m=1 ;;
out:         6) p=0 f=f m=1 ;;
out:         *) p=0 f=- m=0 ;;
out:     esac
out: }
out: _djarg_djinterp_sub() {
out:     case $1:$2 in
out:         '0:list') r=1 ;;
out:         '0:describe') r=2 ;;
out:         '0:get') r=3 ;;
out:         '0:set') r=4 ;;
out:         '0:help') r=5 ;;
out:         '0:completion') r=6 ;;
out:         *) r= ;;
out:     esac
out: }
out: _djarg_djinterp_opt() {
out:     case $1:$2 in
out:         '0:-h') r=0 ;;
out:         '0:--help') r=0 ;;
out:         '0:--version') r=1 ;;
out:         '0:-q') r=2 ;;
out:         '0:--quiet') r=2 ;;
out:         '0:-v') r=3 ;;
out:         '0:--verbose') r=3 ;;
out:         '0:--color') r=4 ;;
out:         '1:-h') r=5 ;;
out:         '1:--help') r=5 ;;
out:         '2:-h') r=6 ;;
out:         '2:--help') r=6 ;;
out:         '3:-h') r=8 ;;
out:         '3:--help') r=8 ;;
out:         '3:--show-origin') r=10 ;;
out:         '4:-h') r=11 ;;
out:         '4:--help') r=11 ;;
out:         '5:-h') r=13 ;;
out:         '5:--help') r=13 ;;
out:         '6:-h') r=15 ;;
out:         '6:--help') r=15 ;;
out:         *) r= ;;
out:     esac
out: }
out: _djarg_djinterp_info() {
out:     case $1 in
out:         0) n=0 x=0 k=- ;;
out:         1) n=0 x=0 k=- ;;
out:         2) n=0 x=0 k=- ;;
out:         3) n=0 x=0 k=- ;;
out:         4) n=0 x=0 k=- ;;
out:         5) n=0 x=0 k=- ;;
out:         6) n=0 x=0 k=- ;;
out:         7) n=1 x=1 k=f ;;
out:         8) n=0 x=0 k=- ;;
out:         9) n=0 x=0 k=f ;;
out:         10) n=0 x=0 k=- ;;
out:         11) n=0 x=0 k=- ;;
out:         12) n=1 x=1 k=f ;;
out:         13) n=0 x=0 k=- ;;
out:         14) n=0 x=2 k=f ;;
out:         15) n=0 x=0 k=- ;;
out:         16) n=1 x=1 k=f ;;
out:         *) n=0 x=0 k=- ;;
out:     esac
out: }
out: _djarg_djinterp_pos() {
out:     case $1:$2 in
out:         2:0) r=7 y=1 ;;
out:         3:0) r=9 y=-1 ;;
out:         4:0) r=12 y=-1 ;;
out:         5:0) r=14 y=2 ;;
out:         6:0) r=16 y=1 ;;
out:         *) r= ;;
out:     esac
out: }
out: _djarg_djinterp_subs() {
out:     case $1 in
out:         0) c=( 'list' 'describe' 'get' 'set' 'help' 'completion' ) ;;
out:         *) c=() ;;
out:     esac
out: }
out: _djarg_djinterp_opts() {
out:     case $1 in
out:         0) c=( '-h' '--help' '--version' '-q' '--quiet' '-v' '--verbose' '--color' ) ;;
out:         1) c=( '-h' '--help' ) ;;
out:         2) c=( '-h' '--help' ) ;;
out:         3) c=( '-h' '--help' '--show-origin' ) ;;
out:         4) c=( '-h' '--help' ) ;;
out:         5) c=( '-h' '--help' ) ;;
out:         6) c=( '-h' '--help' ) ;;
out:         *) c=() ;;
out:     esac
out: }
out: _djarg_djinterp_vals() {
out:     case $1 in
out:         *) c=() ;;
out:     esac
out: }
out: __djarg_djinterp_first() {
out:     # whether `$1` may begin a name
out:     case $1 in
out:         ''|-|'!'|[[:space:]]|[[:cntrl:]]) return 1 ;;
out:     esac
out:     return 0
out: }
out: __djarg_djinterp_find() {
out:     # o: the option named `$1` at the command or, falling
out:     # through, above it
out:     local L=$cmd p f m r
out:     o=
out:     while :; do
out:         _djarg_djinterp_opt "$L" "$1"
out:         if [[ -n $r ]]; then
out:             o=$r
out:             return
out:         fi
out:         _djarg_djinterp_cmd "$L"
out:         if [[ $f == *f* ]] && (( L != 0 )); then
out:             L=$p
out:         else
out:             return
out:         fi
out:     done
out: }
out: __djarg_djinterp_target() {
out:     # t: the subcommand `$1` names, from the command up, and l:
out:     # the command it is under
out:     local L=$cmd p f m r
out:     t= l=
out:     while :; do
out:         _djarg_djinterp_cmd "$L"
out:         if (( m == 0 )) || (( ${used[$L]:-0} < m )) ||
out:            [[ $f != *s* ]]; then
out:             _djarg_djinterp_sub "$L" "$1"
out:             if [[ -n $r ]]; then
out:                 t=$r l=$L
out:                 return
out:             fi
out:         fi
out:         if [[ $f == *s* ]] && (( L != 0 )); then
out:             L=$p
out:         else
out:             return
out:         fi
out:     done
out: }
out: __djarg_djinterp_class() {
out:     # r: what `$1` is to the command -- mark, sub, long, short,
out:     # win, term or none
out:     local w=$1
out:     r=none
out:     if [[ $w == -- ]]; then
out:         r=mark
out:         return
out:     fi
out:     __djarg_djinterp_target "$w"
out:     if [[ -n $t ]]; then
out:         r=sub
out:         return
out:     fi
out:     case $w in
out:         --?*)
out:             if __djarg_djinterp_first "${w:2:1}"; then
out:                 r=long
out:             fi
out:             return
out:             ;;
out:         -?*)
out:             if ! __djarg_djinterp_first "${w:1:1}"; then
out:                 return
out:             fi
out:             case ${w:1:2} in
out:                 [0-9]*|.[0-9])
out:                     _djarg_djinterp_opt "$cmd" "-${w:1:1}"
out:                     if [[ -z $r ]]; then
out:                         r=none
out:                         return
out:                     fi
out:                     ;;
out:             esac
out:             r=short
out:             return
out:             ;;
out:     esac
out:     if [[ $cf == *w* ]] && [[ $w == /?* ]] &&
out:        __djarg_djinterp_first "${w:1:1}"; then
out:         r=win
out:     elif [[ $w == ++ ]] && (( cmd != 0 )); then
out:         r=term
out:     fi
out: }
out: __djarg_djinterp_take() {
out:     # o: the positional that takes a word, from the command up,
out:     # counted when `$1` is 1; extra: the last command's flags
out:     local L=$cmd s r y p f m
out:     o=
out:     while :; do
out:         s=0
out:         while :; do
out:             _djarg_djinterp_pos "$L" "$s"
out:             if [[ -z $r ]]; then
out:                 break
out:             fi
out:             if (( y < 0 )) || (( ${counts[$r]:-0} < y )); then
out:                 o=$r
out:                 if (( $1 )); then
out:                     counts[$r]=$(( ${counts[$r]:-0} + 1 ))
out:                 fi
out:                 return
out:             fi
out:             s=$(( s + 1 ))
out:         done
out:         _djarg_djinterp_cmd "$L"
out:         if [[ $f == *f* ]] && (( L != 0 )); then
out:             L=$p
out:         else
out:             extra=$f
out:             return
out:         fi
out:     done
out: }
out: __djarg_djinterp_given() {
out:     # the option found, met with the value `$1` -- empty for
out:     # none: what it still needs, and what more it may take
out:     local n x k got=0
out:     if [[ -z $o ]]; then
out:         return
out:     fi
out:     _djarg_djinterp_info "$o"
out:     if (( x == 0 )); then
out:         return
out:     fi
out:     if [[ -n $1 ]]; then
out:         got=1
out:     fi
out:     need=$(( n - got ))
out:     if (( need < 0 )); then
out:         need=0
out:     fi
out:     if (( x < 0 )); then
out:         room=-1
out:     elif (( got > n )); then
out:         room=$(( x - got ))
out:     else
out:         room=$(( x - n ))
out:     fi
out:     if (( need > 0 )) || (( room != 0 )); then
out:         opt=$o
out:     fi
out: }
out: __djarg_djinterp_step() {
out:     # one word the parse meets
out:     local w=$1 r t l o name rest n x k
out:     __djarg_djinterp_class "$w"
out:     case $r in
out:         mark)
out:             only=1
out:             ;;
out:         sub)
out:             used[$l]=$(( ${used[$l]:-0} + 1 ))
out:             cmd=$t
out:             _djarg_djinterp_cmd "$cmd"
out:             cf=$f
out:             ;;
out:         term)
out:             _djarg_djinterp_cmd "$cmd"
out:             cmd=$p
out:             _djarg_djinterp_cmd "$cmd"
out:             cf=$f
out:             ;;
out:         long)
out:             name=${w%%=*}
out:             rest=${w#"$name"}
out:             __djarg_djinterp_find "$name"
out:             __djarg_djinterp_given "${rest:1}"
out:             ;;
out:         win)
out:             name=${w%%:*}
out:             rest=${w#"$name"}
out:             __djarg_djinterp_find "--${name:1}"
out:             if [[ -z $o ]]; then
out:                 __djarg_djinterp_find "-${name:1}"
out:             fi
out:             __djarg_djinterp_given "${rest:1}"
out:             ;;
out:         short)
out:             rest=${w:1}
out:             while [[ -n $rest ]]; do
out:                 name=-${rest:0:1}
out:                 rest=${rest:1}
out:                 __djarg_djinterp_find "$name"
out:                 if [[ -z $o ]]; then
out:                     break
out:                 fi
out:                 _djarg_djinterp_info "$o"
out:                 if (( x != 0 )); then
out:                     __djarg_djinterp_given "$rest"
out:                     break
out:                 fi
out:             done
out:             ;;
out:         *)
out:             __djarg_djinterp_take 1
out:             ;;
out:     esac
out: }
out: __djarg_djinterp_words() {
out:     # words and cword: the line to the cursor in words, rejoining
out:     # what COMP_WORDBREAKS split; tail: the part readline replaces
out:     local line=${COMP_LINE:0:COMP_POINT} i=0 w lead
out:     words=() cword=-1 tail=
out:     while (( i <= COMP_CWORD )); do
out:         w=${COMP_WORDS[i]}
out:         lead=${line%%[![:space:]]*}
out:         line=${line#"$lead"}
out:         if (( i == COMP_CWORD )); then
out:             w=$line
out:         fi
out:         line=${line#"$w"}
out:         if [[ -n $lead ]] || (( cword < 0 )); then
out:             cword=$(( cword + 1 ))
out:             words[cword]=$w
out:         else
out:             words[cword]=${words[cword]}$w
out:         fi
out:         i=$(( i + 1 ))
out:     done
out:     tail=$w
out: }
out: __djarg_djinterp_unq() {
out:     # r: `$1` with its quotes and escapes removed
out:     local s=$1 out= ch q=
out:     case $s in
out:         *[\\\'\"]*) ;;
out:         *) r=$s; return ;;
out:     esac
out:     while [[ -n $s ]]; do
out:         ch=${s:0:1} s=${s:1}
out:         if [[ $q == "'" ]]; then
out:             if [[ $ch == "'" ]]; then
out:                 q=
out:             else
out:                 out=$out$ch
out:             fi
out:         elif [[ $q == '"' ]]; then
out:             if [[ $ch == '"' ]]; then
out:                 q=
out:             elif [[ $ch == '\' ]]; then
out:                 case ${s:0:1} in
out:                     '"'|'\'|'$'|'`') out=$out${s:0:1} s=${s:1} ;;
out:                     *) out=$out$ch ;;
out:                 esac
out:             else
out:                 out=$out$ch
out:             fi
out:         else
out:             case $ch in
out:                 "'"|'"') q=$ch ;;
out:                 '\') out=$out${s:0:1} s=${s:1} ;;
out:                 *) out=$out$ch ;;
out:             esac
out:         fi
out:     done
out:     r=$out
out: }
out: __djarg_djinterp_kind() {
out:     # the values of kind `$1` -- c, the choices in c; f, files; d,
out:     # directories -- that start with `$3`, after `$2`
out:     local v
out:     case $1 in
out:         c)
out:             if (( ${#c[@]} > 0 )); then
out:                 for v in "${c[@]}"; do
out:                     if [[ $v == "$3"* ]]; then
out:                         reply+=( "$2$v" )
out:                     fi
out:                 done
out:             fi
out:             ;;
out:         f|d)
out:             files=1
out:             while IFS= read -r v; do
out:                 reply+=( "$2$v" )
out:             done < <(compgen -"$1" -- "$3")
out:             ;;
out:     esac
out: }
out: __djarg_djinterp_values() {
out:     # the values option `$1` takes that start with `$3`, after `$2`
out:     local n x k c=()
out:     _djarg_djinterp_info "$1"
out:     if [[ $k == c ]]; then
out:         _djarg_djinterp_vals "$1"
out:     fi
out:     __djarg_djinterp_kind "$k" "$2" "$3"
out: }
out: __djarg_djinterp_names() {
out:     # the names list `$1` gives that start with `$2`, each once:
out:     # at the command and, for options falling through, above it
out:     local L=$cmd c v p f m seen==
out:     while :; do
out:         c=()
out:         "$1" "$L"
out:         if (( ${#c[@]} > 0 )); then
out:             for v in "${c[@]}"; do
out:                 if [[ $v == "$2"* ]] && [[ $seen != *"=$v="* ]]; then
out:                     seen=$seen$v=
out:                     reply+=( "$v" )
out:                 fi
out:             done
out:         fi
out:         _djarg_djinterp_cmd "$L"
out:         if [[ $1 == *_opts ]] && [[ $f == *f* ]] && (( L != 0 ))
out:         then
out:             L=$p
out:         else
out:             return
out:         fi
out:     done
out: }
out: __djarg_djinterp_reply() {
out:     # COMPREPLY: the reply as readline replaces the word -- less
out:     # what precedes the last word break, and escaped unless quoted
out:     # or completed as file names
out:     local s=$tail ch pre v q
out:     while [[ -n $s ]]; do
out:         ch=${s:0:1} s=${s:1}
out:         case $COMP_WORDBREAKS in
out:             *"$ch"*) ;;
out:             *) break ;;
out:         esac
out:         if [[ -z $s ]]; then
out:             tail=
out:         fi
out:     done
out:     __djarg_djinterp_unq "${words[cword]%"$tail"}"
out:     pre=$r
out:     COMPREPLY=()
out:     if (( ${#reply[@]} > 0 )); then
out:         for v in "${reply[@]}"; do
out:             if [[ $v != "$pre"* ]]; then
out:                 continue
out:             fi
out:             v=${v#"$pre"}
out:             case $tail in
out:                 \'*|\"*) ;;
out:                 *)
out:                     if (( ! files )); then
out:                         printf -v q '%q' "$v"
out:                         v=$q
out:                     fi
out:                     ;;
out:             esac
out:             COMPREPLY+=( "$v" )
out:         done
out:     fi
out:     if (( files )) && type compopt >/dev/null 2>&1; then
out:         compopt -o filenames
out:     fi
out: }
out: __djarg_djinterp_offer() {
out:     # reply: what may come at the cursor, `$cur`
out:     if (( need > 0 )); then
out:         __djarg_djinterp_values "$opt" "" "$cur"
out:         return
out:     fi
out:     if (( only )); then
out:         __djarg_djinterp_take 0
out:         if [[ -n $o ]]; then
out:             __djarg_djinterp_values "$o" "" "$cur"
out:         fi
out:         return
out:     fi
out:     if [[ -n $opt ]]; then
out:         __djarg_djinterp_values "$opt" "" "$cur"
out:     fi
out:     case $cur in
out:         --*=*)
out:             __djarg_djinterp_find "${cur%%=*}"
out:             if [[ -n $o ]]; then
out:                 __djarg_djinterp_values "$o" "${cur%%=*}=" "${cur#*=}"
out:             fi
out:             ;;
out:         -*)
out:             __djarg_djinterp_names _djarg_djinterp_opts "$cur"
out:             ;;
out:         *)
out:             __djarg_djinterp_take 0
out:             if [[ -n $o ]]; then
out:                 __djarg_djinterp_values "$o" "" "$cur"
out:             elif [[ $extra == *e* ]]; then
out:                 __djarg_djinterp_kind f "" "$cur"
out:             fi
out:             _djarg_djinterp_cmd "$cmd"
out:             c=()
out:             if (( m == 0 )) || (( ${used[$cmd]:-0} < m )); then
out:                 _djarg_djinterp_subs "$cmd"
out:             fi
out:             if (( ${#c[@]} > 0 )); then
out:                 __djarg_djinterp_names _djarg_djinterp_subs "$cur"
out:             elif [[ -z $o ]] && [[ $extra != *e* ]]; then
out:                 __djarg_djinterp_names _djarg_djinterp_opts "$cur"
out:             fi
out:             ;;
out:     esac
out: }
out: _djarg_djinterp() {
out:     local words cword tail cur r t l o p f m n x k cf w i
out:     local cmd=0 opt= need=0 room=0 only=0 extra= files=0 nocase=0
out:     local -a used counts reply c
out:     if shopt -q nocasematch; then
out:         nocase=1
out:         shopt -u nocasematch
out:     fi
out:     __djarg_djinterp_words
out:     _djarg_djinterp_cmd 0
out:     cf=$f
out:     i=1
out:     while (( i < cword )); do
out:         __djarg_djinterp_unq "${words[i]}"
out:         w=$r
out:         i=$(( i + 1 ))
out:         if (( need > 0 )); then
out:             need=$(( need - 1 ))
out:             if (( need == 0 )) && (( room == 0 )); then
out:                 opt=
out:             fi
out:             continue
out:         fi
out:         if (( only )); then
out:             __djarg_djinterp_take 1
out:             continue
out:         fi
out:         if [[ -n $opt ]]; then
out:             if [[ $w == -- ]]; then
out:                 opt=
out:                 continue
out:             fi
out:             __djarg_djinterp_class "$w"
out:             if [[ $r == none ]] && (( room != 0 )); then
out:                 if (( room > 0 )); then
out:                     room=$(( room - 1 ))
out:                 fi
out:                 if (( room == 0 )); then
out:                     opt=
out:                 fi
out:                 continue
out:             fi
out:             opt=
out:         fi
out:         __djarg_djinterp_step "$w"
out:     done
out:     __djarg_djinterp_unq "${words[cword]}"
out:     cur=$r
out:     reply=()
out:     __djarg_djinterp_offer
out:     __djarg_djinterp_reply
out:     if (( nocase )); then
out:         shopt -s nocasematch
out:     fi
out: }
out: complete -F _djarg_djinterp 'djinterp'
> completion zsh
exit 0
out: #compdef djinterp
out: # zsh completion for djinterp, generated by djinterp's arg_parser.
out: # Source it after compinit, or save it as _<program> in a directory of $fpath.
out: 
out: _djarg_djinterp_cmd() {
out:     case $1 in
out:         0) p=0 f=s m=1 ;;
out:         1) p=0 f=f m=1 ;;
out:         2) p=0 f=f m=1 ;;
out:         3) p=0 f=f m=1 ;;
out:         4) p=0 f=f m=1 ;;
out:         5) p=0 f=f m=1 ;;
out:         6) p=0 f=f m=1 ;;
out:         *) p=0 f=- m=0 ;;
out:     esac
out: }
out: _djarg_djinterp_sub() {
out:     case $1:$2 in
out:         '0:list') r=1 ;;
out:         '0:describe') r=2 ;;
out:         '0:get') r=3 ;;
out:         '0:set') r=4 ;;
out:         '0:help') r=5 ;;
out:         '0:completion') r=6 ;;
out:         *) r= ;;
out:     esac
out: }
out: _djarg_djinterp_opt() {
out:     case $1:$2 in
out:         '0:-h') r=0 ;;
out:         '0:--help') r=0 ;;
out:         '0:--version') r=1 ;;
out:         '0:-q') r=2 ;;
out:         '0:--quiet') r=2 ;;
out:         '0:-v') r=3 ;;
out:         '0:--verbose') r=3 ;;
out:         '0:--color') r=4 ;;
out:         '1:-h') r=5 ;;
out:         '1:--help') r=5 ;;
out:         '2:-h') r=6 ;;
out:         '2:--help') r=6 ;;
out:         '3:-h') r=8 ;;
out:         '3:--help') r=8 ;;
out:         '3:--show-origin') r=10 ;;
out:         '4:-h') r=11 ;;
out:         '4:--help') r=11 ;;
out:         '5:-h') r=13 ;;
out:         '5:--help') r=13 ;;
out:         '6:-h') r=15 ;;
out:         '6:--help') r=15 ;;
out:         *) r= ;;
out:     esac
out: }
out: _djarg_djinterp_info() {
out:     case $1 in
out:         0) n=0 x=0 k=- ;;
out:         1) n=0 x=0 k=- ;;
out:         2) n=0 x=0 k=- ;;
out:         3) n=0 x=0 k=- ;;
out:         4) n=0 x=0 k=- ;;
out:         5) n=0 x=0 k=- ;;
out:         6) n=0 x=0 k=- ;;
out:         7) n=1 x=1 k=f ;;
out:         8) n=0 x=0 k=- ;;
out:         9) n=0 x=0 k=f ;;
out:         10) n=0 x=0 k=- ;;
out:         11) n=0 x=0 k=- ;;
out:         12) n=1 x=1 k=f ;;
out:         13) n=0 x=0 k=- ;;
out:         14) n=0 x=2 k=f ;;
out:         15) n=0 x=0 k=- ;;
out:         16) n=1 x=1 k=f ;;
out:         *) n=0 x=0 k=- ;;
out:     esac
out: }
out: _djarg_djinterp_pos() {
out:     case $1:$2 in
out:         2:0) r=7 y=1 ;;
out:         3:0) r=9 y=-1 ;;
out:         4:0) r=12 y=-1 ;;
out:         5:0) r=14 y=2 ;;
out:         6:0) r=16 y=1 ;;
out:         *) r= ;;
out:     esac
out: }
out: _djarg_djinterp_subs() {
out:     case $1 in
out:         0) c=( 'list' 'describe' 'get' 'set' 'help' 'completion' ) d=( 'list the djins, a line each' 'describe a djin: its commands and settings' 'print settings as statements that load back; every one, without a NAME' 'write settings to the user'\''s settings file' 'display help for a command' 'print a completion script for a shell' ) ;;
out:         *) c=() d=() ;;
out:     esac
out: }
out: _djarg_djinterp_opts() {
out:     case $1 in
out:         0) c=( '-h' '--help' '--version' '-q' '--quiet' '-v' '--verbose' '--color' ) d=( 'display this help and exit' 'display this help and exit' 'output version information and exit' 'say nothing but errors' 'say nothing but errors' 'say more; twice, more again' 'say more; twice, more again' 'colour diagnostics: auto (the default), always or never' ) ;;
out:         1) c=( '-h' '--help' ) d=( 'display this help and exit' 'display this help and exit' ) ;;
out:         2) c=( '-h' '--help' ) d=( 'display this help and exit' 'display this help and exit' ) ;;
out:         3) c=( '-h' '--help' '--show-origin' ) d=( 'display this help and exit' 'display this help and exit' 'say where each value came from, and what lies under it' ) ;;
out:         4) c=( '-h' '--help' ) d=( 'display this help and exit' 'display this help and exit' ) ;;
out:         5) c=( '-h' '--help' ) d=( 'display this help and exit' 'display this help and exit' ) ;;
out:         6) c=( '-h' '--help' ) d=( 'display this help and exit' 'display this help and exit' ) ;;
out:         *) c=() d=() ;;
out:     esac
out: }
out: _djarg_djinterp_vals() {
out:     case $1 in
out:         *) c=() ;;
out:     esac
out: }
out: __djarg_djinterp_first() {
out:     # whether `$1` may begin a name
out:     case $1 in
out:         ''|-|'!'|[[:space:]]|[[:cntrl:]]) return 1 ;;
out:     esac
out:     return 0
out: }
out: __djarg_djinterp_find() {
out:     # o: the option named `$1` at the command or, falling
out:     # through, above it
out:     local L=$cmd p f m r
out:     o=
out:     while :; do
out:         _djarg_djinterp_opt "$L" "$1"
out:         if [[ -n $r ]]; then
out:             o=$r
out:             return
out:         fi
out:         _djarg_djinterp_cmd "$L"
out:         if [[ $f == *f* ]] && (( L != 0 )); then
out:             L=$p
out:         else
out:             return
out:         fi
out:     done
out: }
out: __djarg_djinterp_target() {
out:     # t: the subcommand `$1` names, from the command up, and l:
out:     # the command it is under
out:     local L=$cmd p f m r
out:     t= l=
out:     while :; do
out:         _djarg_djinterp_cmd "$L"
out:         if (( m == 0 )) || (( ${used[$L]:-0} < m )) ||
out:            [[ $f != *s* ]]; then
out:             _djarg_djinterp_sub "$L" "$1"
out:             if [[ -n $r ]]; then
out:                 t=$r l=$L
out:                 return
out:             fi
out:         fi
out:         if [[ $f == *s* ]] && (( L != 0 )); then
out:             L=$p
out:         else
out:             return
out:         fi
out:     done
out: }
out: __djarg_djinterp_class() {
out:     # r: what `$1` is to the command -- mark, sub, long, short,
out:     # win, term or none
out:     local w=$1
out:     r=none
out:     if [[ $w == -- ]]; then
out:         r=mark
out:         return
out:     fi
out:     __djarg_djinterp_target "$w"
out:     if [[ -n $t ]]; then
out:         r=sub
out:         return
out:     fi
out:     case $w in
out:         --?*)
out:             if __djarg_djinterp_first "${w:2:1}"; then
out:                 r=long
out:             fi
out:             return
out:             ;;
out:         -?*)
out:             if ! __djarg_djinterp_first "${w:1:1}"; then
out:                 return
out:             fi
out:             case ${w:1:2} in
out:                 [0-9]*|.[0-9])
out:                     _djarg_djinterp_opt "$cmd" "-${w:1:1}"
out:                     if [[ -z $r ]]; then
out:                         r=none
out:                         return
out:                     fi
out:                     ;;
out:             esac
out:             r=short
out:             return
out:             ;;
out:     esac
out:     if [[ $cf == *w* ]] && [[ $w == /?* ]] &&
out:        __djarg_djinterp_first "${w:1:1}"; then
out:         r=win
out:     elif [[ $w == ++ ]] && (( cmd != 0 )); then
out:         r=term
out:     fi
out: }
out: __djarg_djinterp_take() {
out:     # o: the positional that takes a word, from the command up,
out:     # counted when `$1` is 1; extra: the last command's flags
out:     local L=$cmd s r y p f m
out:     o=
out:     while :; do
out:         s=0
out:         while :; do
out:             _djarg_djinterp_pos "$L" "$s"
out:             if [[ -z $r ]]; then
out:                 break
out:             fi
out:             if (( y < 0 )) || (( ${counts[$r]:-0} < y )); then
out:                 o=$r
out:                 if (( $1 )); then
out:                     counts[$r]=$(( ${counts[$r]:-0} + 1 ))
out:                 fi
out:                 return
out:             fi
out:             s=$(( s + 1 ))
out:         done
out:         _djarg_djinterp_cmd "$L"
out:         if [[ $f == *f* ]] && (( L != 0 )); then
out:             L=$p
out:         else
out:             extra=$f
out:             return
out:         fi
out:     done
out: }
out: __djarg_djinterp_given() {
out:     # the option found, met with the value `$1` -- empty for
out:     # none: what it still needs, and what more it may take
out:     local n x k got=0
out:     if [[ -z $o ]]; then
out:         return
out:     fi
out:     _djarg_djinterp_info "$o"
out:     if (( x == 0 )); then
out:         return
out:     fi
out:     if [[ -n $1 ]]; then
out:         got=1
out:     fi
out:     need=$(( n - got ))
out:     if (( need < 0 )); then
out:         need=0
out:     fi
out:     if (( x < 0 )); then
out:         room=-1
out:     elif (( got > n )); then
out:         room=$(( x - got ))
out:     else
out:         room=$(( x - n ))
out:     fi
out:     if (( need > 0 )) || (( room != 0 )); then
out:         opt=$o
out:     fi
out: }
out: __djarg_djinterp_step() {
out:     # one word the parse meets
out:     local w=$1 r t l o name rest n x k
out:     __djarg_djinterp_class "$w"
out:     case $r in
out:         mark)
out:             only=1
out:             ;;
out:         sub)
out:             used[$l]=$(( ${used[$l]:-0} + 1 ))
out:             cmd=$t
out:             _djarg_djinterp_cmd "$cmd"
out:             cf=$f
out:             ;;
out:         term)
out:             _djarg_djinterp_cmd "$cmd"
out:             cmd=$p
out:             _djarg_djinterp_cmd "$cmd"
out:             cf=$f
out:             ;;
out:         long)
out:             name=${w%%=*}
out:             rest=${w#"$name"}
out:             __djarg_djinterp_find "$name"
out:             __djarg_djinterp_given "${rest:1}"
out:             ;;
out:         win)
out:             name=${w%%:*}
out:             rest=${w#"$name"}
out:             __djarg_djinterp_find "--${name:1}"
out:             if [[ -z $o ]]; then
out:                 __djarg_djinterp_find "-${name:1}"
out:             fi
out:             __djarg_djinterp_given "${rest:1}"
out:             ;;
out:         short)
out:             rest=${w:1}
out:             while [[ -n $rest ]]; do
out:                 name=-${rest:0:1}
out:                 rest=${rest:1}
out:                 __djarg_djinterp_find "$name"
out:                 if [[ -z $o ]]; then
out:                     break
out:                 fi
out:                 _djarg_djinterp_info "$o"
out:                 if (( x != 0 )); then
out:                     __djarg_djinterp_given "$rest"
out:                     break
out:                 fi
out:             done
out:             ;;
out:         *)
out:             __djarg_djinterp_take 1
out:             ;;
out:     esac
out: }
out: __djarg_djinterp_values() {
out:     # offers the values option `$1` takes
out:     local n x k c=()
out:     _djarg_djinterp_info "$1"
out:     case $k in
out:         c)
out:             _djarg_djinterp_vals "$1"
out:             compadd -a c
out:             ;;
out:         f)
out:             _files
out:             ;;
out:         d)
out:             _files -/
out:             ;;
out:     esac
out: }
out: __djarg_djinterp_names() {
out:     # offers the names list `$1` gives, each once with its
out:     # description, as `$2` and `$3`: at the command and, for
out:     # options falling through, above it
out:     local L=$cmd c d p f m i
out:     local -a specs
out:     local -A seen
out:     while :; do
out:         c=() d=()
out:         "$1" "$L"
out:         i=1
out:         while (( i <= ${#c[@]} )); do
out:             if (( ! ${+seen[${c[i]}]} )); then
out:                 seen[${c[i]}]=1
out:                 specs+=( "${c[i]//:/\\:}:${d[i]}" )
out:             fi
out:             i=$(( i + 1 ))
out:         done
out:         _djarg_djinterp_cmd "$L"
out:         if [[ $1 == *_opts ]] && [[ $f == *f* ]] && (( L != 0 ))
out:         then
out:             L=$p
out:         else
out:             break
out:         fi
out:     done
out:     _describe -t "$2" "$3" specs
out: }
out: __djarg_djinterp_offer() {
out:     # offers what may come at the cursor, `$cur`
out:     if (( need > 0 )); then
out:         __djarg_djinterp_values "$opt"
out:         return
out:     fi
out:     if (( only )); then
out:         __djarg_djinterp_take 0
out:         if [[ -n $o ]]; then
out:             __djarg_djinterp_values "$o"
out:         fi
out:         return
out:     fi
out:     if [[ -n $opt ]]; then
out:         __djarg_djinterp_values "$opt"
out:     fi
out:     case $cur in
out:         --*=*)
out:             __djarg_djinterp_find "${cur%%=*}"
out:             if [[ -n $o ]]; then
out:                 compset -P 1 '*='
out:                 __djarg_djinterp_values "$o"
out:             fi
out:             ;;
out:         -*)
out:             __djarg_djinterp_names _djarg_djinterp_opts options option
out:             ;;
out:         *)
out:             __djarg_djinterp_take 0
out:             if [[ -n $o ]]; then
out:                 __djarg_djinterp_values "$o"
out:             elif [[ $extra == *e* ]]; then
out:                 _files
out:             fi
out:             _djarg_djinterp_cmd "$cmd"
out:             c=()
out:             if (( m == 0 )) || (( ${used[$cmd]:-0} < m )); then
out:                 _djarg_djinterp_subs "$cmd"
out:             fi
out:             if (( ${#c[@]} > 0 )); then
out:                 __djarg_djinterp_names _djarg_djinterp_subs commands command
out:             elif [[ -z $o ]] && [[ $extra != *e* ]]; then
out:                 __djarg_djinterp_names _djarg_djinterp_opts options option
out:             fi
out:             ;;
out:     esac
out: }
out: _djarg_djinterp() {
out:     local cur r t l o p f m n x k cf w i d
out:     local cmd=0 opt= need=0 room=0 only=0 extra=
out:     local -a c
out:     local -A used counts
out:     _djarg_djinterp_cmd 0
out:     cf=$f
out:     i=2
out:     while (( i < CURRENT )); do
out:         w=${(Q)words[i]}
out:         i=$(( i + 1 ))
out:         if (( need > 0 )); then
out:             need=$(( need - 1 ))
out:             if (( need == 0 )) && (( room == 0 )); then
out:                 opt=
out:             fi
out:             continue
out:         fi
out:         if (( only )); then
out:             __djarg_djinterp_take 1
out:             continue
out:         fi
out:         if [[ -n $opt ]]; then
out:             if [[ $w == -- ]]; then
out:                 opt=
out:                 continue
out:             fi
out:             __djarg_djinterp_class "$w"
out:             if [[ $r == none ]] && (( room != 0 )); then
out:                 if (( room > 0 )); then
out:                     room=$(( room - 1 ))
out:                 fi
out:                 if (( room == 0 )); then
out:                     opt=
out:                 fi
out:                 continue
out:             fi
out:             opt=
out:         fi
out:         __djarg_djinterp_step "$w"
out:     done
out:     cur=${(Q)PREFIX}
out:     __djarg_djinterp_offer
out: }
out: if [[ ${funcstack[1]-} == '_djinterp' ]]; then
out:     compdef _djarg_djinterp 'djinterp'
out:     _djarg_djinterp "$@"
out: elif (( ${+functions[compdef]} )); then
out:     compdef _djarg_djinterp 'djinterp'
out: else
out:     print -ru2 -- 'djinterp' 'completion needs compinit first'
out: fi
> completion fish
exit 0
out: # fish completion for djinterp, generated by djinterp's arg_parser.
out: # Source it in fish, or save it as <program>.fish in a directory of
out: # $fish_complete_path.
out: 
out: set -g -- __djarg_djinterp_cmds \
out:     '0 s 1 1 6 1 8' \
out:     '0 f 1 7 0 9 2' \
out:     '0 f 1 7 0 11 2' \
out:     '0 f 1 7 0 13 3' \
out:     '0 f 1 7 0 16 2' \
out:     '0 f 1 7 0 18 2' \
out:     '0 f 1 7 0 20 2'
out: set -g -- __djarg_djinterp_sk \
out:     '0:list' \
out:     '0:describe' \
out:     '0:get' \
out:     '0:set' \
out:     '0:help' \
out:     '0:completion'
out: set -g -- __djarg_djinterp_sn \
out:     'list' \
out:     'describe' \
out:     'get' \
out:     'set' \
out:     'help' \
out:     'completion'
out: set -g -- __djarg_djinterp_st \
out:     1 \
out:     2 \
out:     3 \
out:     4 \
out:     5 \
out:     6
out: set -g -- __djarg_djinterp_sd \
out:     'list the djins, a line each' \
out:     'describe a djin: its commands and settings' \
out:     'print settings as statements that load back; every one, without a NAME' \
out:     'write settings to the user\'s settings file' \
out:     'display help for a command' \
out:     'print a completion script for a shell'
out: set -g -- __djarg_djinterp_ok \
out:     '0:-h' \
out:     '0:--help' \
out:     '0:--version' \
out:     '0:-q' \
out:     '0:--quiet' \
out:     '0:-v' \
out:     '0:--verbose' \
out:     '0:--color' \
out:     '1:-h' \
out:     '1:--help' \
out:     '2:-h' \
out:     '2:--help' \
out:     '3:-h' \
out:     '3:--help' \
out:     '3:--show-origin' \
out:     '4:-h' \
out:     '4:--help' \
out:     '5:-h' \
out:     '5:--help' \
out:     '6:-h' \
out:     '6:--help'
out: set -g -- __djarg_djinterp_on \
out:     '-h' \
out:     '--help' \
out:     '--version' \
out:     '-q' \
out:     '--quiet' \
out:     '-v' \
out:     '--verbose' \
out:     '--color' \
out:     '-h' \
out:     '--help' \
out:     '-h' \
out:     '--help' \
out:     '-h' \
out:     '--help' \
out:     '--show-origin' \
out:     '-h' \
out:     '--help' \
out:     '-h' \
out:     '--help' \
out:     '-h' \
out:     '--help'
out: set -g -- __djarg_djinterp_ov \
out:     0 \
out:     0 \
out:     1 \
out:     2 \
out:     2 \
out:     3 \
out:     3 \
out:     4 \
out:     5 \
out:     5 \
out:     6 \
out:     6 \
out:     8 \
out:     8 \
out:     10 \
out:     11 \
out:     11 \
out:     13 \
out:     13 \
out:     15 \
out:     15
out: set -g -- __djarg_djinterp_od \
out:     'display this help and exit' \
out:     'display this help and exit' \
out:     'output version information and exit' \
out:     'say nothing but errors' \
out:     'say nothing but errors' \
out:     'say more; twice, more again' \
out:     'say more; twice, more again' \
out:     'colour diagnostics: auto (the default), always or never' \
out:     'display this help and exit' \
out:     'display this help and exit' \
out:     'display this help and exit' \
out:     'display this help and exit' \
out:     'display this help and exit' \
out:     'display this help and exit' \
out:     'say where each value came from, and what lies under it' \
out:     'display this help and exit' \
out:     'display this help and exit' \
out:     'display this help and exit' \
out:     'display this help and exit' \
out:     'display this help and exit' \
out:     'display this help and exit'
out: set -g -- __djarg_djinterp_info \
out:     '0 0 - 1 0' \
out:     '0 0 - 1 0' \
out:     '0 0 - 1 0' \
out:     '0 0 - 1 0' \
out:     '0 0 - 1 0' \
out:     '0 0 - 1 0' \
out:     '0 0 - 1 0' \
out:     '1 1 f 1 0' \
out:     '0 0 - 1 0' \
out:     '0 0 f 1 0' \
out:     '0 0 - 1 0' \
out:     '0 0 - 1 0' \
out:     '1 1 f 1 0' \
out:     '0 0 - 1 0' \
out:     '0 2 f 1 0' \
out:     '0 0 - 1 0' \
out:     '1 1 f 1 0'
out: set -g -- __djarg_djinterp_pk \
out:     '2:0' \
out:     '3:0' \
out:     '4:0' \
out:     '5:0' \
out:     '6:0'
out: set -g -- __djarg_djinterp_pv \
out:     '7 1' \
out:     '9 -1' \
out:     '12 -1' \
out:     '14 2' \
out:     '16 1'
out: set -g -- __djarg_djinterp_vv
out: 
out: function __djarg_djinterp_row
out:     # the fields of row `$argv[2]` of table `$argv[1]`
out:     set -l table __djarg_djinterp_$argv[1]
out:     string split ' ' -- $$table[1][(math $argv[2] + 1)]
out: end
out: 
out: function __djarg_djinterp_first
out:     # whether `$argv[1]` may begin a name
out:     string match -qr -- '^[^\-!\s\x00-\x1f\x7f]' "$argv[1]"
out: end
out: 
out: function __djarg_djinterp_unq
out:     # the token `$argv[1]` with its quotes and escapes removed
out:     set -l s "$argv[1]"
out:     if string match -qr -- '^\'[^\']*$|^"[^"]*$' "$s"
out:         string sub -s 2 -- "$s"
out:     else if not string unescape -- "$s"
out:         printf '%s\n' "$s"
out:     end
out: end
out: 
out: function __djarg_djinterp_find -S
out:     # o: the option named `$argv[1]` at the command or, falling
out:     # through, above it
out:     set -l L $cmd
out:     set o
out:     while true
out:         set -l i (contains -i -- "$L:$argv[1]" $__djarg_djinterp_ok)
out:         if test -n "$i"
out:             set o $__djarg_djinterp_ov[$i]
out:             return
out:         end
out:         set -l c (__djarg_djinterp_row cmds $L)
out:         if string match -q -- '*f*' $c[2]; and test $L -ne 0
out:             set L $c[1]
out:         else
out:             return
out:         end
out:     end
out: end
out: 
out: function __djarg_djinterp_target -S
out:     # t: the subcommand `$argv[1]` names, from the command up, and
out:     # l: the command it is under
out:     set -l L $cmd
out:     set t
out:     set l
out:     while true
out:         set -l c (__djarg_djinterp_row cmds $L)
out:         set -l u $used[(math $L + 1)]
out:         if test -z "$u"
out:             set u 0
out:         end
out:         if test $c[3] -eq 0; or test $u -lt $c[3]
out:             or not string match -q -- '*s*' $c[2]
out:             set -l i (contains -i -- "$L:$argv[1]" $__djarg_djinterp_sk)
out:             if test -n "$i"
out:                 set t $__djarg_djinterp_st[$i]
out:                 set l $L
out:                 return
out:             end
out:         end
out:         if string match -q -- '*s*' $c[2]; and test $L -ne 0
out:             set L $c[1]
out:         else
out:             return
out:         end
out:     end
out: end
out: 
out: function __djarg_djinterp_class -S
out:     # r: what `$argv[1]` is to the command -- mark, sub, long,
out:     # short, win, term or none
out:     set -l w "$argv[1]"
out:     set r none
out:     if test "$w" = --
out:         set r mark
out:         return
out:     end
out:     __djarg_djinterp_target "$w"
out:     if test -n "$t"
out:         set r sub
out:         return
out:     end
out:     if string match -q -- '--?*' "$w"
out:         if __djarg_djinterp_first (string sub -s 3 -l 1 -- "$w")
out:             set r long
out:         end
out:         return
out:     end
out:     if string match -q -- '-?*' "$w"
out:         set -l first (string sub -s 2 -l 1 -- "$w")
out:         if not __djarg_djinterp_first "$first"
out:             return
out:         end
out:         if string match -qr -- '^-([0-9]|\.[0-9])' "$w"
out:             and not contains -- "$cmd:-$first" $__djarg_djinterp_ok
out:             return
out:         end
out:         set r short
out:         return
out:     end
out:     if string match -q -- '*w*' $cf; and string match -q -- '/?*' "$w"
out:         and __djarg_djinterp_first (string sub -s 2 -l 1 -- "$w")
out:         set r win
out:     else if test "$w" = ++; and test $cmd -ne 0
out:         set r term
out:     end
out: end
out: 
out: function __djarg_djinterp_take -S
out:     # o: the positional that takes a word, from the command up,
out:     # counted when `$argv[1]` is 1; extra: the last command's flags
out:     set -l L $cmd
out:     set o
out:     while true
out:         set -l s 0
out:         while true
out:             set -l i (contains -i -- "$L:$s" $__djarg_djinterp_pk)
out:             if test -z "$i"
out:                 break
out:             end
out:             set -l e (string split ' ' -- $__djarg_djinterp_pv[$i])
out:             set -l n $counts[(math $e[1] + 1)]
out:             if test -z "$n"
out:                 set n 0
out:             end
out:             if test $e[2] -lt 0; or test $n -lt $e[2]
out:                 set o $e[1]
out:                 if test $argv[1] -eq 1
out:                     set counts[(math $e[1] + 1)] (math $n + 1)
out:                 end
out:                 return
out:             end
out:             set s (math $s + 1)
out:         end
out:         set -l c (__djarg_djinterp_row cmds $L)
out:         if string match -q -- '*f*' $c[2]; and test $L -ne 0
out:             set L $c[1]
out:         else
out:             set extra $c[2]
out:             return
out:         end
out:     end
out: end
out: 
out: function __djarg_djinterp_given -S
out:     # the option found, met with the value `$argv[1]` -- empty for
out:     # none: what it still needs, and what more it may take
out:     if test -z "$o"
out:         return
out:     end
out:     set -l e (__djarg_djinterp_row info $o)
out:     if test $e[2] -eq 0
out:         return
out:     end
out:     set -l got 0
out:     if test -n "$argv[1]"
out:         set got 1
out:     end
out:     set need (math $e[1] - $got)
out:     if test $need -lt 0
out:         set need 0
out:     end
out:     if test $e[2] -lt 0
out:         set room -1
out:     else if test $got -gt $e[1]
out:         set room (math $e[2] - $got)
out:     else
out:         set room (math $e[2] - $e[1])
out:     end
out:     if test $need -gt 0; or test $room -ne 0
out:         set opt $o
out:     end
out: end
out: 
out: function __djarg_djinterp_step -S
out:     # one word the parse meets
out:     set -l w "$argv[1]"
out:     set -l r
out:     set -l t
out:     set -l l
out:     set -l o
out:     __djarg_djinterp_class "$w"
out:     switch $r
out:         case mark
out:             set only 1
out:         case sub
out:             set -l u $used[(math $l + 1)]
out:             if test -z "$u"
out:                 set u 0
out:             end
out:             set used[(math $l + 1)] (math $u + 1)
out:             set cmd $t
out:             set cf (__djarg_djinterp_row cmds $cmd)[2]
out:         case term
out:             set cmd (__djarg_djinterp_row cmds $cmd)[1]
out:             set cf (__djarg_djinterp_row cmds $cmd)[2]
out:         case long win
out:             set -l at =
out:             if test $r = win
out:                 set at :
out:             end
out:             set -l name (string split -m 1 -- $at "$w")
out:             set -l value "$name[2]"
out:             if test $r = long
out:                 __djarg_djinterp_find "$name[1]"
out:             else
out:                 set name (string sub -s 2 -- "$name[1]")
out:                 __djarg_djinterp_find "--$name"
out:                 if test -z "$o"
out:                     __djarg_djinterp_find "-$name"
out:                 end
out:             end
out:             __djarg_djinterp_given "$value"
out:         case short
out:             set -l rest (string sub -s 2 -- "$w")
out:             while test -n "$rest"
out:                 set -l name -(string sub -l 1 -- "$rest")
out:                 set rest (string sub -s 2 -- "$rest")
out:                 __djarg_djinterp_find "$name"
out:                 if test -z "$o"
out:                     break
out:                 end
out:                 if test (__djarg_djinterp_row info $o)[2] -ne 0
out:                     __djarg_djinterp_given "$rest"
out:                     break
out:                 end
out:             end
out:         case '*'
out:             __djarg_djinterp_take 1
out:     end
out: end
out: 
out: function __djarg_djinterp_kind
out:     # prints the values of kind `$argv[1]` -- c, choices
out:     # `$argv[4]` on; f, files; d, directories -- after `$argv[2]`,
out:     # for the text `$argv[3]`
out:     switch $argv[1]
out:         case c
out:             for v in $argv[4..-1]
out:                 printf '%s%s\n' "$argv[2]" "$v"
out:             end
out:         case f
out:             set -l w (string escape -- "$argv[3]")
out:             for v in (__fish_complete_path "$w")
out:                 printf '%s%s\n' "$argv[2]" "$v"
out:             end
out:         case d
out:             set -l w (string escape -- "$argv[3]")
out:             for v in (__fish_complete_directories "$w" '')
out:                 printf '%s%s\n' "$argv[2]" "$v"
out:             end
out:     end
out: end
out: 
out: function __djarg_djinterp_values
out:     # prints the values option `$argv[1]` takes, after `$argv[2]`,
out:     # for the text `$argv[3]`
out:     set -l e (__djarg_djinterp_row info $argv[1])
out:     set -l v
out:     if test $e[3] = c; and test $e[5] -gt 0
out:         set v $__djarg_djinterp_vv[$e[4]..(math $e[4] + $e[5] - 1)]
out:     end
out:     __djarg_djinterp_kind $e[3] "$argv[2]" "$argv[3]" $v
out: end
out: 
out: function __djarg_djinterp_names -S
out:     # prints the names of kind `$argv[1]` -- s, subcommands; o,
out:     # options -- each once with its description: at the command
out:     # and, for options falling through, above it
out:     set -l L $cmd
out:     set -l seen
out:     while true
out:         set -l c (__djarg_djinterp_row cmds $L)
out:         set -l i $c[4]
out:         set -l z (math $c[4] + $c[5])
out:         set -l names __djarg_djinterp_sn
out:         set -l texts __djarg_djinterp_sd
out:         if test $argv[1] = o
out:             set i $c[6]
out:             set z (math $c[6] + $c[7])
out:             set names __djarg_djinterp_on
out:             set texts __djarg_djinterp_od
out:         end
out:         while test $i -lt $z
out:             set -l name $$names[1][$i]
out:             if not contains -- "$name" $seen
out:                 set -a seen "$name"
out:                 printf '%s\t%s\n' "$name" $$texts[1][$i]
out:             end
out:             set i (math $i + 1)
out:         end
out:         if test $argv[1] = o; and string match -q -- '*f*' $c[2]
out:             and test $L -ne 0
out:             set L $c[1]
out:         else
out:             return
out:         end
out:     end
out: end
out: 
out: function __djarg_djinterp_offer -S
out:     # prints what may come at the cursor, `$cur`
out:     if test $need -gt 0
out:         __djarg_djinterp_values $opt '' "$cur"
out:         return
out:     end
out:     if test $only -eq 1
out:         __djarg_djinterp_take 0
out:         if test -n "$o"
out:             __djarg_djinterp_values $o '' "$cur"
out:         end
out:         return
out:     end
out:     if test -n "$opt"
out:         __djarg_djinterp_values $opt '' "$cur"
out:     end
out:     if string match -q -- '--*=*' "$cur"
out:         set -l name (string split -m 1 -- = "$cur")
out:         __djarg_djinterp_find "$name[1]"
out:         if test -n "$o"
out:             __djarg_djinterp_values $o "$name[1]=" "$name[2]"
out:         end
out:     else if string match -q -- '-*' "$cur"
out:         __djarg_djinterp_names o
out:     else
out:         __djarg_djinterp_take 0
out:         if test -n "$o"
out:             __djarg_djinterp_values $o '' "$cur"
out:         else if string match -q -- '*e*' "$extra"
out:             __djarg_djinterp_kind f '' "$cur"
out:         end
out:         set -l c (__djarg_djinterp_row cmds $cmd)
out:         set -l u $used[(math $cmd + 1)]
out:         if test -z "$u"
out:             set u 0
out:         end
out:         if test $c[5] -gt 0
out:             and begin
out:                 test $c[3] -eq 0; or test $u -lt $c[3]
out:             end
out:             __djarg_djinterp_names s
out:         else if test -z "$o"
out:             and not string match -q -- '*e*' "$extra"
out:             __djarg_djinterp_names o
out:         end
out:     end
out: end
out: 
out: function __djarg_djinterp_complete
out:     # prints the completions for the command line
out:     set -l tokens (commandline -opc)
out:     set -l cur (__djarg_djinterp_unq (commandline -ct))
out:     set -l cmd 0
out:     set -l cf (__djarg_djinterp_row cmds 0)[2]
out:     set -l opt
out:     set -l need 0
out:     set -l room 0
out:     set -l only 0
out:     set -l extra
out:     set -l used
out:     set -l counts
out:     set -l r
out:     set -l t
out:     set -l l
out:     set -l o
out:     for w in $tokens[2..-1]
out:         if test $need -gt 0
out:             set need (math $need - 1)
out:             if test $need -eq 0; and test $room -eq 0
out:                 set opt
out:             end
out:             continue
out:         end
out:         if test $only -eq 1
out:             __djarg_djinterp_take 1
out:             continue
out:         end
out:         if test -n "$opt"
out:             if test "$w" = --
out:                 set opt
out:                 continue
out:             end
out:             __djarg_djinterp_class "$w"
out:             if test $r = none; and test $room -ne 0
out:                 if test $room -gt 0
out:                     set room (math $room - 1)
out:                 end
out:                 if test $room -eq 0
out:                     set opt
out:                 end
out:                 continue
out:             end
out:             set opt
out:         end
out:         __djarg_djinterp_step "$w"
out:     end
out:     __djarg_djinterp_offer
out: end
out: 
out: complete -c 'djinterp' -e
out: complete -c 'djinterp' -f -a '(__djarg_djinterp_complete)'
> completion powershell
exit 0
out: # PowerShell completion for djinterp, generated by djinterp's arg_parser.
out: # Run it in PowerShell -- from the profile, to keep it.
out: 
out: & {
out:     $cmds = @(
out:         '0 s 1 0 6 0 8'
out:         '0 f 1 6 0 8 2'
out:         '0 f 1 6 0 10 2'
out:         '0 f 1 6 0 12 3'
out:         '0 f 1 6 0 15 2'
out:         '0 f 1 6 0 17 2'
out:         '0 f 1 6 0 19 2'
out:     )
out:     $sn = @(
out:         'list'
out:         'describe'
out:         'get'
out:         'set'
out:         'help'
out:         'completion'
out:     )
out:     $sc = @(
out:         0
out:         0
out:         0
out:         0
out:         0
out:         0
out:     )
out:     $st = @(
out:         1
out:         2
out:         3
out:         4
out:         5
out:         6
out:     )
out:     $sd = @(
out:         'list the djins, a line each'
out:         'describe a djin: its commands and settings'
out:         'print settings as statements that load back; every one, without a NAME'
out:         'write settings to the user''s settings file'
out:         'display help for a command'
out:         'print a completion script for a shell'
out:     )
out:     $on = @(
out:         '-h'
out:         '--help'
out:         '--version'
out:         '-q'
out:         '--quiet'
out:         '-v'
out:         '--verbose'
out:         '--color'
out:         '-h'
out:         '--help'
out:         '-h'
out:         '--help'
out:         '-h'
out:         '--help'
out:         '--show-origin'
